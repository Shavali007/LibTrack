# Copy to .env and replace placeholders with your environment configuration.
MYSQL_DATABASE=libtrack
MYSQL_USER=libtrack
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
MYSQL_PORT=3307

# Frontend base URL for email links (password reset, email verification)
# For local development: http://localhost:4200 (or http://<LAN-IP>:4200 if testing from mobile/other devices)
# For production: https://libtrack.yourdomain.com
LIBTRACK_FRONTEND_BASE_URL=http://localhost:4200
